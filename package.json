{
  "name": "reframed-mcp",
  "version": "1.1.0",
  "description": "MCP server that tailors a resume to a job posting — voice-preserving, ATS-aware, with a provenance summary. Runs with no API key on the free tier.",
  "type": "module",
  "bin": {
    "reframed-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "resume",
    "resume-tailoring",
    "cv",
    "ats",
    "job-search",
    "job-application",
    "career",
    "claude",
    "claude-code",
    "cursor",
    "continue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notaprompt/reframed-mcp"
  }
}
